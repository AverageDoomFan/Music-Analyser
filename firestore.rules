rules_version = '2';

// Music Energy Analyzer — Firestore security rules.
//
// Data model
//   admins/{uid}                 exists = this user is an admin. Created by hand in the
//                                Firebase console; no client can ever write here.
//   users/{uid}                  profile + counters, written by its owner only
//   users/{uid}/duels/{id}       the owner's duels (> < =)
//   users/{uid}/reports/{id}     the owner's reports for analysis
//
// Who can do what
//   - a signed-in user reads and writes only under users/{their uid};
//   - an admin reads everything (users, every duel and report), writes nothing
//     of other users;
//   - everything else is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function str(v, max) {
      return v is string && v.size() <= max;
    }
    function optStr(data, key, max) {
      return !(key in data) || data[key] == null || str(data[key], max);
    }
    function optNum(data, key) {
      return !(key in data) || data[key] == null || data[key] is number;
    }

    function validUser(d) {
      return d.keys().hasOnly(['name', 'email', 'lastSync', 'counts', 'app', 'library'])
        && optStr(d, 'name', 120)
        && optStr(d, 'email', 200)
        && d.lastSync is timestamp
        && (!('counts' in d) || (d.counts is map && d.counts.size() <= 10))
        && (!('app' in d) || (d.app is map && d.app.size() <= 10))
        && (!('library' in d) || (d.library is map && d.library.size() <= 20));
    }

    function validDuel(d) {
      return d.keys().hasOnly(['a', 'b', 'aName', 'bName', 'winner', 'at', 'source', 'scores', 'algorithm'])
        && str(d.a, 200) && str(d.b, 200)
        && optStr(d, 'aName', 300) && optStr(d, 'bName', 300)
        && d.winner in ['a', 'b', 'tie']
        && d.at is number
        && optStr(d, 'source', 20)
        && optStr(d, 'algorithm', 20)
        && (!('scores' in d) || (d.scores is list && d.scores.size() == 2));
    }

    function validReport(d) {
      return d.keys().hasOnly(['trackId', 'name', 'at', 'expected', 'finalScore', 'comment', 'algorithm', 'extractor', 'data'])
        && str(d.trackId, 200)
        && str(d.name, 300)
        && str(d.at, 40)
        && optNum(d, 'expected')
        && optNum(d, 'finalScore')
        && optStr(d, 'comment', 2000)
        && optStr(d, 'algorithm', 20)
        && optStr(d, 'extractor', 20)
        && str(d.data, 950000);
    }

    match /admins/{uid} {
      // a user may check whether they are an admin; nobody writes from the app
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(uid) && validUser(request.resource.data);
      allow delete: if isOwner(uid);

      match /duels/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) && validDuel(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /reports/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) && validReport(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }

    // admin views across every user (collection group queries)
    match /{path=**}/duels/{id} {
      allow read: if isAdmin();
    }
    match /{path=**}/reports/{id} {
      allow read: if isAdmin();
    }
  }
}
